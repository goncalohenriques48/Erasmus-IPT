@{
    ViewData["Title"] = "Documentação e Informações";
}

<div class="container-fluid pt-3 pb-5">
    
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary text-white rounded p-3 me-3 shadow-sm">
            <i class="bi bi-journal-text" style="font-size: 2rem;"></i>
        </div>
        <div>
            <h1 class="display-6 fw-bold text-primary mb-0">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Consulta aqui todos os guiões, parceiros e informações financeiras essenciais para a tua mobilidade.</p>
        </div>
    </div>

    <div class="row g-4">
        
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary text-center p-4 transition-hover">
                <i class="bi bi-file-earmark-pdf text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-body mb-2">Coordenadores</h5>
                <p class="text-muted small mb-4">Lista atualizada dos Coordenadores Erasmus de cada curso do IPT.</p>
                <a href="http://www.gri.ipt.pt/?pagina=pt/coordenadore/" target="_blank" class="btn btn-outline-primary mt-auto rounded-pill fw-bold">
                    <i class="bi bi-eye me-1"></i> Ler Documento
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary text-center p-4 transition-hover">
                <i class="bi bi-file-earmark-pdf text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-body mb-2">Acordos Bilaterais Erasmus+</h5>
                <p class="text-muted small mb-4">Instituições de Ensino Superior europeias com acordo válido. (Descarregar PDF no final da página)</p>
                <a href="http://www.gri.ipt.pt/?pagina=pt/p/" target="_blank" class="btn btn-outline-primary mt-auto rounded-pill fw-bold">
                    <i class="bi bi-eye me-1"></i> Ler Documento
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary text-center p-4 transition-hover">
                <i class="bi bi-file-earmark-pdf text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-body mb-2">Acordos Internacionais</h5>
                <p class="text-muted small mb-4">Parceiros de mobilidade no Brasil, PALOP's, China e Macau. (Descarregar PDF no final da página)</p>
                <a href="http://www.gri.ipt.pt/?pagina=pt/p/" target="_blank" class="btn btn-outline-primary mt-auto rounded-pill fw-bold">
                    <i class="bi bi-eye me-1"></i> Ler Documento
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary text-center p-4 transition-hover">
                <i class="bi bi-file-earmark-pdf text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-body mb-2">Tabelas Bolsas Erasmus+ 2025</h5>
                <p class="text-muted small mb-4">Valores de financiamento atribuídos por país de destino. ( Ver final da página)</p>
                <a href="http://www.gri.ipt.pt/?pagina=pt/mobilidades_outgoing/" target="_blank" class="btn btn-outline-primary mt-auto rounded-pill fw-bold">
                    <i class="bi bi-eye me-1"></i> Ler Documento
                </a>
            </div>
        </div>

    </div>
</div>

<style>
    /* Pequeno efeito para o cartão subir quando se passa o rato */
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }
</style>