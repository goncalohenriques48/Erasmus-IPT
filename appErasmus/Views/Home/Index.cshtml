@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container-fluid pt-3">
    
    <div class="p-4 p-md-5 mb-4 rounded border position-relative overflow-hidden hero-banner shadow-sm">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
        
        <div class="col-lg-8 px-0 position-relative z-1">
            <h1 class="display-5 display-md-4 text-white fw-bold">O teu mundo não tem fronteiras! 🌍</h1>
            <p class="lead my-3 text-white">
                Bem-vindo ao portal Erasmus+ do Instituto Politécnico de Tomar. Descobre oportunidades de mobilidade para estudos, estágios e ensino. Prepara-te para a experiência da tua vida.
            </p>
            <div class="mt-4">
                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg fw-bold text-white me-2 mb-2 shadow">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Entrar no Portal
                    </a>
                }
                <a href="#como-funciona" class="btn btn-secondary btn-lg mb-2 shadow text-white fw-bold">
                    <i class="bi bi-info-circle me-2"></i> Saber Mais
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary">
                <div class="card-body text-center p-4">
                    <div class="text-primary mb-3">
                        <i class="bi bi-mortarboard" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Para Estudantes</h5>
                    <p class="card-text text-muted">Realiza um semestre de estudos numa universidade parceira ou um estágio internacional para impulsionares a tua carreira e o teu currículo.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary">
                <div class="card-body text-center p-4">
                    <div class="text-warning mb-3">
                        <i class="bi bi-person-workspace" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Para Docentes e Staff</h5>
                    <p class="card-text text-muted">Aproveita as oportunidades de mobilidade para missões de ensino e formação técnica em instituições europeias.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary">
                <div class="card-body text-center p-4">
                    <div class="text-info mb-3">
                        <i class="bi bi-globe-americas" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Destinos</h5>
                    <p class="card-text text-muted">Explora a nossa vasta rede de universidades e empresas parceiras por toda a Europa e além-fronteiras.</p>
                </div>
            </div>
        </div>
    </div>

    <div id="como-funciona" class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-body-tertiary">
                <div class="card-header bg-transparent border-bottom pt-3 pb-3">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-map me-2"></i>Como funciona o processo?</h5>
                </div>
                <div class="card-body">
                    <div class="row row-cols-2 row-cols-md-4 text-center mt-3 mb-4 g-4">
                        
                        <div class="col">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.3rem;">
                                1
                            </div>
                            <h6 class="fw-bold mb-1">Explorar</h6>
                            <small class="text-muted d-block px-1">Informa-te sobre os destinos e as condições.</small>
                        </div>
                        
                        <div class="col">
                            <div class="bg-body-secondary text-body rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.3rem;">
                                2
                            </div>
                            <h6 class="fw-bold mb-1">Candidatar</h6>
                            <small class="text-muted d-block px-1">Submete a tua candidatura neste portal.</small>
                        </div>
                        
                        <div class="col">
                            <div class="bg-body-secondary text-body rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.3rem;">
                                3
                            </div>
                            <h6 class="fw-bold mb-1">Aprovação</h6>
                            <small class="text-muted d-block px-1">Validação pelo Coordenador e pelo GRI.</small>
                        </div>

                        <div class="col">
                            <div class="bg-body-secondary text-body rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.3rem;">
                                4
                            </div>
                            <h6 class="fw-bold mb-1">Viajar</h6>
                            <small class="text-muted d-block px-1">Gere o Learning Agreement e prepara as malas!</small>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5 mb-4">
        <div class="col-12 mb-3">
            <h5 class="text-primary fw-bold border-bottom pb-2">
                <i class="bi bi-info-square me-2"></i>Condições de Mobilidade
            </h5>
        </div>
        
        <div class="col-md-6 mb-4 mb-md-0">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded p-2 me-3 shadow-sm">
                            <i class="bi bi-book" style="font-size: 1.5rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Mobilidade de Estudos</h5>
                    </div>
                    <p class="card-text text-muted">
                        Podes fazer um período de estudos numa instituição de ensino superior de um país europeu, ou uma combinação de período de estudos e de estágio.
                    </p>
                    <hr class="text-muted" />
                    <p class="card-text mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>
                        <strong>Duração:</strong> Entre 2 a 12 meses letivos.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm bg-body-tertiary">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning text-dark rounded p-2 me-3 shadow-sm">
                            <i class="bi bi-briefcase" style="font-size: 1.5rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Mobilidade de Estágio</h5>
                    </div>
                    <p class="card-text text-muted">
                        Podes fazer um estágio numa empresa europeia. Pode ser para recém-diplomado se tiveres sido selecionado no teu último ano de curso no IPT.
                    </p>
                    <hr class="text-muted" />
                    <p class="card-text mb-0">
                        <i class="bi bi-clock-history text-warning me-2"></i>
                        <strong>Duração:</strong> Entre 2 a 12 meses civis.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5 mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-body-tertiary">
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        
                        <div class="col-lg-7">
                            <h4 class="fw-bold text-primary text-uppercase mb-4">
                                <i class="bi bi-person-lines-fill me-2"></i>Contactos
                            </h4>

                            <h6 class="text-uppercase fw-bold text-body mb-2">Instituto Politécnico de Tomar (IPT)</h6>
                            
                            <div class="d-flex align-items-start mb-3">
                                <i class="bi bi-geo-alt-fill text-primary me-3 mt-1" style="font-size: 1.2rem;"></i>
                                <p class="mb-0">
                                    Av. Dr. Cândido Madureira, n.º 13,<br />
                                    2300-531 Tomar - Portugal
                                </p>
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-telephone-fill text-primary me-3" style="font-size: 1.2rem;"></i>
                                <p class="mb-0">+351 249 328 100</p>
                            </div>

                            <div class="d-flex align-items-center mb-4">
                                <i class="bi bi-envelope-fill text-primary me-3" style="font-size: 1.2rem;"></i>
                                <p class="mb-0">
                                    <a href="mailto:gri@ipt.pt" class="text-decoration-none text-body-secondary fw-bold">gri@ipt.pt</a>
                                </p>
                            </div>

                            <hr class="text-muted opacity-25" />

                            <h6 class="text-uppercase fw-bold text-body mb-2 mt-4">Horário de Atendimento</h6>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clock-fill text-primary me-3" style="font-size: 1.2rem;"></i>
                                <p class="mb-0">Segunda a Sexta-feira: 09h00-12h30 e 14h00-17h30</p>
                            </div>
                        </div>

                        <div class="col-lg-5 d-flex align-items-center justify-content-center justify-content-lg-end pt-2 pt-lg-0">
                            <div class="d-flex flex-row flex-lg-column flex-wrap gap-4 align-items-center justify-content-center justify-content-lg-end w-100">
                                <img src="~/images/erasmus.png" alt="Logótipo Erasmus+" style="max-height: 60px; max-width: 100%; object-fit: contain;" class="opacity-75" />
                                <img src="~/images/logoKreativEU.png" alt="Logótipo KreativEU" style="max-height: 75px; max-width: 100%; object-fit: contain;" class="opacity-75" />
                                <img src="~/images/europeanLogo.png" alt="Logótipo União Europeia" style="max-height: 75px; max-width: 100%; object-fit: contain;" class="opacity-75" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>