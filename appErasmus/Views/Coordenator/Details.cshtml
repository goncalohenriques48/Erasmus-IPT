@model appErasmus.Models.Candidatura

@{
    ViewData["Title"] = "Avaliar Candidatura";

    // --- MAPEAMENTO DINÂMICO DE ÍCONES, CORES E TEXTOS FORMATADOS ---
    string classeIcone = "bi-hourglass-split";
    string classeTexto = "text-warning";
    string descricaoEstado = "A candidatura está aguardar avaliação.";
    string estadoTexto = Model.EstadoCandidatura.ToString();

    switch (Model.EstadoCandidatura) {
        case appErasmus.Models.EnumEstadoCandidatura.EmConstrucao:
            classeIcone = "bi-pencil-square";
            classeTexto = "text-secondary";
            descricaoEstado = "A candidatura ainda se encontra em modo de rascunho pelo aluno.";
            estadoTexto = "Em Construção";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.Submetida:
            classeIcone = "bi-send-check";
            classeTexto = "text-warning";
            descricaoEstado = "Submetida pelo aluno. Aguarda a validação do coordenador.";
            estadoTexto = "Submetida";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.EmAnaliseGRI:
            classeIcone = "bi-search";
            classeTexto = "text-warning";
            descricaoEstado = "Aprovada academicamente. Encontra-se em análise regulamentar pelo GRI.";
            estadoTexto = "Em Análise no GRI";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.DevolvidaParaCorrecao:
            classeIcone = "bi-arrow-counterclockwise";
            classeTexto = "text-info";
            descricaoEstado = "Candidatura devolvida ao aluno para proceder a correções.";
            estadoTexto = "Devolvida para Correção";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.Aceite:
            classeIcone = "bi-airplane";
            classeTexto = "text-primary";
            descricaoEstado = "Candidatura aceite. O aluno encontra-se em período de mobilidade.";
            estadoTexto = "Em Mobilidade";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.EmAnaliseFinalGRI:
            classeIcone = "bi-box-seam";
            classeTexto = "text-info";
            descricaoEstado = "O aluno regressou e submeteu a documentação final. Aguarda fecho pelo GRI.";
            estadoTexto = "Pós-Mobilidade (Em Análise)";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.Finalizado:
            classeIcone = "bi-check-all";
            classeTexto = "text-success";
            descricaoEstado = "Todo o processo administrativo e de mobilidade foi concluído com sucesso.";
            estadoTexto = "Processo Finalizado";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.RejeitadaCoordenador:
        case appErasmus.Models.EnumEstadoCandidatura.RejeitadaNaoAceite:
            classeIcone = "bi-x-circle-fill";
            classeTexto = "text-danger";
            descricaoEstado = "Esta candidatura foi formalmente recusada e encerrada.";
            estadoTexto = "Rejeitada";
            break;
        case appErasmus.Models.EnumEstadoCandidatura.Desistencia:
            classeIcone = "bi-dash-circle-fill";
            classeTexto = "text-muted";
            descricaoEstado = "O aluno desistiu formalmente deste processo de mobilidade.";
            estadoTexto = "Desistência";
            break;
    }
    var categoriasDocumento = ViewBag.CategoriasDocumento as List<appErasmus.Models.CategoriaDocumento> ?? new List<appErasmus.Models.CategoriaDocumento>();

}

<div class="container-fluid pt-4 pb-5">

    <!-- CABEÇALHO DA PÁGINA -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-primary mb-0">
                <i class="bi bi-file-earmark-person me-2"></i>Candidatura de @Model.Aluno.NomeCompleto
            </h2>
            <p class="text-muted mb-0">Avaliação de Candidatura de Mobilidade - Coordenador</p>
        </div>
        <a class="btn btn-outline-secondary shadow-sm" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
        </a>
    </div>

    <div class="row g-4">

        <!-- COLUNA DA ESQUERDA (DADOS DA CANDIDATURA) -->
        <div class="col-lg-8">
            
            <!-- IDENTIFICAÇÃO E DESTINO -->
            <div class="card border-0 shadow-sm mb-4 bg-body-tertiary">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary"><i class="bi bi-person-badge me-2"></i>Identificação e Destino</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Número de Aluno</div>
                        <div class="col-sm-8 text-body">@Model.Aluno.NumeroAluno</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Email de Contacto</div>
                        <div class="col-sm-8"><a href="mailto:@Model.Aluno.Email">@Model.Aluno.Email</a></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Ano / Semestre</div>
                        <div class="col-sm-8 text-body">@Model.AnoLetivo (@Model.Semestre)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Curso</div>
                        <div class="col-sm-8 text-body">
                            @Model.Curso.CodigoCurso - @Model.Curso.NomePTCurso
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Escola</div>
                        <div class="col-sm-8 text-body">@Model.Curso.Escola.Nome</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Grau</div>
                        <div class="col-sm-8 text-body">@Model.Curso.GrauCurso.Nome</div>
                    </div>
                    <hr class="opacity-10" />

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Universidades de Destino</div>
                        <div class="col-sm-8 text-body">
                            @if (Model.CandidaturasUniversidades != null && Model.CandidaturasUniversidades.Any()) {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var uniRelacao in Model.CandidaturasUniversidades.OrderBy(cu => cu.Preferencia)) {
                                        <div>
                                            <span class="badge bg-secondary rounded-pill me-2">@(uniRelacao.Preferencia)ª Opção</span>
                                            @if (!string.IsNullOrWhiteSpace(uniRelacao.OutraUniversidade)) {
                                                <span class="fw-semibold">@uniRelacao.OutraUniversidade</span> <span class="text-body-secondary small fw-normal">(Especificada Manualmente)</span>
                                            }
                                            else {
                                                <span class="fw-semibold">@uniRelacao.Universidade?.Nome</span> <span class="text-body-secondary small fw-normal">(@uniRelacao.UniversidadeFK)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else {
                                <span class="text-danger fst-italic">Nenhuma universidade selecionada</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- COMPETÊNCIAS LINGUÍSTICAS -->
            <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary"><i class="bi bi-translate me-2"></i>Competências Linguísticas</h5>
                </div>
                <div class="card-body">
                    @if (Model.Linguas != null && Model.Linguas.Any()) {
                        <ul class="list-group list-group-flush bg-transparent">
                            @foreach (var lingua in Model.Linguas) {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent text-body border-secondary border-opacity-10">
                                    <span class="fw-medium">@lingua.Lingua</span>
                                    <span class="badge bg-primary rounded-pill">Nível @lingua.Nivel</span>
                                </li>
                            }
                        </ul>
                    }
                    else {
                        <p class="text-body-secondary mb-0"><i class="bi bi-info-circle me-1"></i> O aluno não declarou competências linguísticas.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <!-- 1. PAINEL DE DECISÃO -->
            <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
                <div class="card-body text-center p-4">
                    <h6 class="fw-bold text-uppercase text-body-secondary mb-3" style="font-size: 0.85rem; letter-spacing: 0.5px;">Painel de Decisão</h6>

                    <div class="@classeTexto display-4 mb-2">
                        <i class="bi @classeIcone"></i>
                    </div>
                    <h5 class="@classeTexto fw-bold mb-2">@estadoTexto</h5>
                    <p class="text-body-secondary small mb-0">@descricaoEstado</p>

                    @if (TempData["MensagemSucesso"] != null) {
                        <div class="alert alert-success py-2 small fw-bold mt-3">
                            <i class="bi bi-check-circle me-1"></i> @TempData["MensagemSucesso"]
                        </div>
                    }

                    <hr class="opacity-10" />

                    @if (Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.Submetida) {
                        <form class="mb-3" asp-controller="Coordenator" asp-action="AlterarEstado" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <button class="btn btn-success w-100 shadow-sm fw-bold py-2" type="submit" name="acao" value="AprovarCoordenador">
                                <i class="bi bi-check-lg me-2"></i>Aprovar e Enviar para GRI
                            </button>
                        </form>

                        <form asp-controller="Coordenator" asp-action="AlterarEstado" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="acao" value="RejeitarCoordenador" />

                            <div class="text-start mb-3">
                                <label class="form-label fw-bold text-danger small">
                                    Motivo da rejeição/devolução
                                </label>
                                <textarea class="form-control" name="observacoesDecisao" rows="4" maxlength="1000" required placeholder="Descreva detalhadamente o motivo da decisão..."></textarea>
                                <div class="form-text text-body-secondary" style="font-size: 0.75rem;">
                                    Este texto será enviado e ficará visível para o aluno.
                                </div>
                            </div>
                            <div class="form-check text-start mb-3">
                                <input id="permiteCorrecao" class="form-check-input checkbox-correcao" type="checkbox" name="permiteCorrecao" value="true" />
                                <label class="form-check-label small text-body" for="permiteCorrecao">
                                    Permitir que o aluno corrija e volte a submeter
                                </label>
                            </div>

                            <button class="btn btn-outline-danger w-100 shadow-sm" type="submit" onclick="return confirm('Confirma esta decisão de rejeição/devolução?');">
                                <i class="bi bi-x-lg me-2"></i>Rejeitar / Devolver
                            </button>
                        </form>
                    }
                    else if (Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.DevolvidaParaCorrecao) {
                        <div class="alert alert-info py-2 small fw-bold mb-0">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> A candidatura foi devolvida ao aluno para correção.
                        </div>
                    }
                    else if (Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.Aceite ||
                             Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.RejeitadaCoordenador ||
                             Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.RejeitadaNaoAceite ||
                             Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.Desistencia ||
                             Model.EstadoCandidatura == appErasmus.Models.EnumEstadoCandidatura.Finalizado) {
                        <div class="alert alert-secondary py-2 small fw-bold mb-0 text-body-secondary bg-transparent border">
                            <i class="bi bi-lock-fill me-1"></i> O processo está fechado/concluído e não permite alterações.
                        </div>
                    }
                    else {
                        <div class="alert alert-secondary py-2 small fw-bold mb-0 text-body-secondary bg-transparent border">
                            <i class="bi bi-hourglass-split me-1"></i> Esta candidatura já não se encontra na fase de decisão do coordenador.
                        </div>
                    }
                </div>
            </div>
            <!-- 2. OBSERVAÇÕES DA DECISÃO (PASSOU PARA BAIXO DO PAINEL) -->
            @if (!string.IsNullOrWhiteSpace(Model.MotivoRejeicao)) {
                <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning bg-body-tertiary">
                    <div class="card-body">
                        <h6 class="fw-bold text-body-secondary text-uppercase mb-3">
                            <i class="bi bi-chat-left-text me-2"></i>Observações da Decisão
                        </h6>
                        <p class="mb-0 text-body">
                            @Model.MotivoRejeicao
                        </p>
                    </div>
                </div>
            }
        </div>

        <!-- COLUNA INFERIOR COMPLETA (DOCUMENTOS DA CANDIDATURA) -->
        <div class="col-12">
            <div class="card border-0 shadow-sm mb-4 bg-body-tertiary">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary">
                        <i class="bi bi-paperclip me-2"></i>Documentos da Candidatura
                    </h5>
                </div>

                <div class="card-body">

                    <div class="border rounded p-3 mb-4 bg-body">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-upload me-2"></i>Adicionar documento ao processo
                        </h6>

                        <form asp-controller="Coordenator"
                              asp-action="UploadDocumento"
                              method="post"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="candidaturaId" value="@Model.Id" />

                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Tipo de documento</label>
                                    <select name="categoriaDocumento" class="form-select form-select-sm" required>
                                        <option value="">Selecionar categoria...</option>

                                        @foreach (var categoria in categoriasDocumento) {
                                            <option value="@categoria.Nome">@categoria.Nome</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Descrição</label>
                                    <input type="text"
                                           name="descricaoDocumento"
                                           class="form-control form-control-sm"
                                           maxlength="250"
                                           placeholder="Opcional" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Ficheiro</label>
                                    <input type="file"
                                           name="ficheiroDocumento"
                                           class="form-control form-control-sm"
                                           required
                                           accept=".pdf,.jpg,.jpeg,.png,.docx" />
                                </div>

                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">
                                        <i class="bi bi-plus-circle me-1"></i>Adicionar
                                    </button>
                                </div>
                            </div> 
                        </form>
                    </div>
                    @* O FILTRO ESTÁ AQUI PARA PROTEGER O COORDENADOR *@
                    @if (Model.Documentos != null) {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 bg-transparent">
                                <thead>
                                    <tr class="text-body-secondary small border-bottom">
                                        <th style="width: 25%;">Tipo</th>
                                        <th style="width: 30%;">Ficheiro</th>
                                        <th style="width: 30%;">Registos de Auditoria</th>
                                        <th class="text-end" style="width: 15%;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody class="text-body">
                                    @foreach (var documento in Model.Documentos.Where(d => !d.CategoriaFK.Contains("IBAN")).OrderByDescending(d => d.DataCriacao)) {
                                        <tr class="border-bottom border-secondary border-opacity-10">
                                            <td>
                                                <div class="fw-semibold text-body">@documento.CategoriaFK</div>
                                                @if (!string.IsNullOrWhiteSpace(documento.DescricaoDocumento)) {
                                                    <div class="text-body-secondary small mt-1" style="font-size: 0.8rem;">
                                                        @documento.DescricaoDocumento
                                                    </div>
                                                }
                                            </td>

                                            <td class="text-break text-body-secondary small">@documento.NomeOriginal</td>

                                            <td class="small text-body-secondary" style="font-size: 0.8rem;">
                                                <div>
                                                    <strong>Submetido por:</strong> @(documento.CreatedBy?.NomeCompleto ?? "Não definido")
                                                </div>
                                                <div>
                                                    <strong>Em:</strong> @documento.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                                                </div>

                                                @if (documento.DataAtualizacao.HasValue && (documento.DataAtualizacao.Value - documento.DataCriacao).TotalSeconds > 3) {
                                                    <div class="mt-1"><strong>Atualizado por:</strong> @(documento.UpdatedBy?.NomeCompleto ?? documento.CreatedBy?.NomeCompleto ?? "Não definido")</div>
                                                    <div><strong>Em:</strong> @(documento.DataAtualizacao.HasValue ? documento.DataAtualizacao.Value.ToString("dd/MM/yyyy HH:mm") : documento.DataCriacao.ToString("dd/MM/yyyy HH:mm"))</div>
                                                }
                                            </td>
                                             
                                            <td class="text-end">
                                                <div class="d-flex flex-column gap-2 align-items-end">
                                                    <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-controller="Coordenator" asp-action="DownloadDocumento" asp-route-documentoId="@documento.Id">
                                                        <i class="bi bi-download me-1"></i> Download
                                                    </a>

                                                    <form asp-controller="Coordenator" asp-action="SubstituirDocumento" method="post"
                                                          enctype="multipart/form-data"
                                                          class="d-flex flex-column gap-1 align-items-end"
                                                          onsubmit="return confirm('Confirma a substituição deste documento?');">
                                                        
                                                          @Html.AntiForgeryToken()

                                                        <input type="hidden" name="documentoId" value="@documento.Id" />

                                                        <input type="file"
                                                               name="ficheiroDocumento"
                                                               class="form-control form-control-sm"
                                                               required
                                                               accept=".pdf,.jpg,.jpeg,.png,.docx"
                                                               style="max-width: 220px;" />

                                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                            <i class="bi bi-arrow-repeat me-1"></i> Substituir
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    } else {
                        <div class="alert alert-light border border-secondary border-opacity-10 mb-0 bg-transparent text-body-secondary">
                            <i class="bi bi-info-circle me-2"></i> Ainda não foram adicionados documentos públicos a esta candidatura.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>