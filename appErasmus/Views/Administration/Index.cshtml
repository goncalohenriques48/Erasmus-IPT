@{
    ViewData["Title"] = "Administração";
    var coordenadoresAtuais = ViewBag.CoordenadoresAtuais as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<!-- LINKS DE SUPORTE AO SELECT2 (Garantir que os estilos do Bootstrap 5 se aplicam) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container-fluid pt-4 pb-5">
    @if (TempData["MensagemSucesso"] != null) {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["Erro"] != null) {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    <!-- CABEÇALHO DA PÁGINA -->
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary text-white rounded p-3 me-3 shadow-sm">
            <i class="bi bi-shield-lock" style="font-size: 2rem;"></i>
        </div>
        <div>
            <h1 class="display-6 fw-bold text-primary mb-0">Administração</h1>
            <p class="text-muted mb-0">Área reservada à gestão global e parametrizações do ecossistema Erasmus@IPT.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-person-check me-2"></i>Atribuir Coordenador Erasmus a Curso
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Administration" asp-action="AtribuirCoordenadorCurso" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-start">

                    <!-- SELEÇÃO DE CURSO -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-body small mb-2">Curso de Destino</label>
                        <select id="cursoId" name="cursoId" class="form-select select2-curso" asp-items="ViewBag.Cursos" required>
                            <option value="">-- Seleciona o curso --</option>
                        </select>
                        <div class="form-text text-body-secondary" style="font-size: 0.8rem;">Pesquisa o curso pretendido.</div>
                    </div>

                    <!-- COORDENADOR ATUAL -->
                    <div class="col-md-3">
                        <label for="coordenadorAtual" class="form-label fw-bold text-body small mb-2">Coordenador atual</label>
                        <input id="coordenadorAtual" type="text" class="form-control" value="Sem coordenador" disabled />
                        <div class="form-text text-body-secondary" style="font-size: 0.8rem;">Campo preenchido automaticamente ao selecionar o curso.</div>
                    </div>

                    <!-- NOVO COORDENADOR -->
                    <div class="col-md-3">
                        <label for="coordenadorEmail" class="form-label fw-bold text-body small mb-2">Novo Coordenador Erasmus</label>
                        <input id="coordenadorEmail" type="email" name="coordenadorEmail" class="form-control" required placeholder="coordenador@ipt.pt" />
                        <div class="form-text text-body-secondary" style="font-size: 0.8rem;">Se a conta do utilizador IPT não existir, o sistema irá criá-la automaticamente.</div>
                    </div>

                    <!-- BOTÃO DE SUBMISSÃO -->
                    <div class="col-md-2">
                        <!-- Label invisível (fantasma) para forçar o alinhamento perfeito da grelha -->
                        <label class="form-label fw-bold small mb-2 d-block user-select-none opacity-0">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center border-0" style="height: 38px;">
                            <i class="bi bi-save me-2"></i> Atribuir
                        </button>
                    </div>

                </div>
            </form>
            
            <form asp-controller="Administration" asp-action="RemoverCoordenadorCurso" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cursoIdRemover" name="cursoId" />
                <button type="submit" id="btnRemoverCoordenador" class="btn btn-outline-danger rounded-pill px-4" disabled onclick="return confirm('Confirma a remoção do coordenador deste curso?');">
                    <i class="bi bi-person-dash me-1"></i>
                    Remover coordenador do curso atual
                </button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-person-badge me-2"></i>Atribuir Novo Membro ao GRI
            </h5>
        </div>
        <div class="card-body p-4">
            
            <form asp-action="AtribuirGRI" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-start mb-3">
                    <div class="col-md-10">
                        <label for="griEmail" class="form-label fw-bold text-body small mb-2">Email do utilizador GRI</label>
                        <input id="griEmail" type="email" name="griEmail" class="form-control" required placeholder="gri@ipt.pt" />
                        <div class="form-text text-body-secondary" style="font-size: 0.8rem;">Se a conta IPT não existir, o sistema irá criá-la e atribuir os privilégios totais de GRI automaticamente.</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small mb-2 d-block user-select-none opacity-0">&nbsp;</label>
                        <button type="submit" 
                                class="btn btn-primary w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center border-0" 
                                style="height: 38px;">
                            <i class="bi bi-save me-2"></i>
                            Atribuir
                        </button>
                    </div>
                </div>
            </form>

            <form asp-action="RemoverGRI" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-start">
                    <div class="col-md-10">
                        <label for="griEmailRemover" class="form-label fw-bold text-body small mb-2">Email do utilizador GRI a remover</label>
                        <input id="griEmailRemover" type="email" name="griEmail" class="form-control" required placeholder="gri@ipt.pt" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small mb-2 d-block user-select-none opacity-0">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center" style="height: 38px;" onclick="return confirm('Confirma a remoção deste utilizador da role GRI?');">
                            <i class="bi bi-person-dash me-2"></i> Remover
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-shield-lock me-2"></i>Atribuir Administrador
            </h5>
        </div>
        <div class="card-body p-4">
            
            <form asp-action="AtribuirAdmin" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-start mb-3">
                    <div class="col-md-10">
                        <label for="adminEmail" class="form-label fw-bold text-body small mb-2">
                            Email do utilizador administrador
                        </label>
                        <input id="adminEmail"
                                type="email"
                                name="adminEmail"
                                class="form-control"
                                required
                                placeholder="admin@ipt.pt" />

                        <div class="form-text text-body-secondary" style="font-size: 0.8rem;">
                            Se a conta do utilizador IPT não existir, o sistema irá criá-la automaticamente e atribuir a role Admin.
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small mb-2 d-block user-select-none opacity-0">&nbsp;</label>
                        <button type="submit" 
                                class="btn btn-danger w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center border-0" 
                                style="height: 38px;">
                            <i class="bi bi-save me-2"></i> Atribuir
                        </button>
                    </div>
                </div>
            </form>

            <form asp-action="RemoverAdmin" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-start">
                    <div class="col-md-10">
                        <label for="adminEmailRemover" class="form-label fw-bold text-body small mb-2">Email do administrador a remover</label>
                        <input id="adminEmailRemover" type="email" name="adminEmail" class="form-control" required placeholder="admin@ipt.pt" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small mb-2 d-block user-select-none opacity-0">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center" style="height: 38px;" onclick="return confirm('Confirma a remoção deste utilizador da role Admin?');">
                            <i class="bi bi-person-dash me-2"></i> Remover
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-danger bg-body-tertiary">
        <div class="card-body p-4">
            <h5 class="fw-bold text-danger mb-3">
                <i class="bi bi-database-exclamation me-2"></i>Zona de Perigo: Inicialização do Sistema
            </h5>
            <p class="text-body-secondary mb-3">
                Esta ação vai injetar os dados de base do sistema (Escolas, Cursos, Paises, Universidades Parceiras, Categorias de Documentos, Roles de Segurança e a conta de Super Administrador).
                Esta operação foi concebida para arranques em servidores de produção ou recuperações de desastres.
            </p>

            <form asp-controller="Administration" asp-action="InitializeDatabase" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger shadow-sm fw-bold" onclick="return confirm('ATENÇÃO: Vais forçar o semeio da Base de Dados e injetar/atualizar centenas de registos. Confirmas esta operação crítica?');">
                    <i class="bi bi-database-add me-2"></i>Semear Base de Dados (Seed Data)
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SCRIPT DE SUPORTE AO SELECT2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Conversão do dicionário do backend para o formato JS
        const coordenadoresAtuais = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(coordenadoresAtuais));

        $(document).ready(function () {
            // Inicialização do Select2 no dropdown de Cursos
            $('.select2-curso').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: "Pesquisa por curso ou escola..."
            });

            // Evento disparado quando o utilizador muda o curso selecionado
            $('.select2-curso').on('change', function () {
                const cursoId = $(this).val();
                const coordenadorAtual = coordenadoresAtuais[cursoId] || "Sem coordenador";

                $('#coordenadorAtual').val(coordenadorAtual);
                $('#cursoIdRemover').val(cursoId);

                if (cursoId && coordenadorAtual !== "Sem coordenador") {
                    $('#btnRemoverCoordenador').prop('disabled', false);
                } else {
                    $('#btnRemoverCoordenador').prop('disabled', true);
                }
            });
        });
    </script>
}